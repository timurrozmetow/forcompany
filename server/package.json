{
  "name": "company-drive-server",
  "version": "1.0.0",
  "description": "Corporate file manager backend (Express + MySQL + JWT)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:v2": "node src/db/migrate-v2.js",
    "seed": "node src/db/seed.js",
    "create-user": "node src/db/create-user.js",
    "reconcile": "node src/db/reconcile.js",
    "reindex": "node src/db/reindex.js",
    "test": "node --test",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mime-types": "^2.1.35",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.15",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  }
}
