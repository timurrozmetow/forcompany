# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=company_drive
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---- Storage ----
# Must be OUTSIDE the web root and NOT served by Nginx directly.
STORAGE_DIR=/var/www/company-drive/storage
MAX_FILE_SIZE_GB=10

# ---- CORS ----
# Comma separated list of allowed origins.
CORS_ORIGIN=https://yourdomain.com

# ---- Misc ----
# Set to "true" if behind a reverse proxy (Nginx) so req.ip uses X-Forwarded-For.
TRUST_PROXY=true
